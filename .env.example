# Copy to .env.local and fill in real values. Never commit .env.local.

# Resend (https://resend.com) API key used to send the summary email.
RESEND_API_KEY=

# Verified "from" address in your Resend account.
RESEND_FROM_ADDRESS=onboarding@resend.dev

# Default recipient if the caller doesn't specify one.
DEFAULT_SUMMARY_EMAIL_TO=tomknowsai@gmail.com

# Default Slack (or Slack-compatible) incoming webhook URL if the caller
# doesn't specify one. Must be HTTPS.
DEFAULT_SLACK_WEBHOOK_URL=
